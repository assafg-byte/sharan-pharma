# Local development (SQLite file — already works, no changes needed)
DATABASE_URL=file:./dev.db

# Required everywhere (local + production). Signs login tokens and the PSP
# edit cookie — there is NO default; the app will not run without it.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# Production site URL (NextAuth)
NEXTAUTH_URL=https://your-domain.example

# Public address used for link previews (WhatsApp etc.). Optional.
SITE_URL=https://your-domain.example

# Production database (Turso / LibSQL). Leave empty to use the local dev.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Password that unlocks edit mode on the /psp and /nucala pages. Edit mode
# stays locked until this is set.
PSP_EDIT_PASSWORD=
